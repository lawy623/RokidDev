<?xml version="1.0" encoding="utf-8"?>
<!--
  The ASR client reaches the server through the local JSch forward
  (http://127.0.0.1:18765). Loopback HTTP is exempt from the platform's
  cleartext ban; every other host keeps the default (cleartext blocked).
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
