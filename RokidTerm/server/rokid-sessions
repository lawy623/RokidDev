#!/usr/bin/env bash
# RokidTerm conversation switcher (server side; design spec 2026-08-07).
# Structured tab-separated output; NEVER prints message bodies. Session
# title = first user message. Requires python3 (session-title extraction)
# and tmux. Install:
#   scp server/rokid-sessions <user>@<host>:/home/<user>/bin/rokid-sessions
#   ssh <user>@<host> chmod +x /home/<user>/bin/rokid-sessions
set -u
# Env-overridable for portability (user requirement 2026-08-11): a new server
# can point these at its own layouts without editing the helper.
PROJECTS_DIR="${ROKID_SESSIONS_PROJECTS_DIR:-$HOME/.claude/projects}"
CLAUDE_LAUNCHER="${ROKID_SESSIONS_LAUNCHER:-/home/rokid/bin/rokid-claude}"

encode() { printf '%s' "$1" | tr -c 'A-Za-z0-9' '-'; }

# First user-message text of a session JSONL (single line, control chars
# stripped, <= 40 chars). Streams; exits at the first user text block.
# Handles BOTH transcript shapes: entries with a direct "content" field and
# entries rewritten by compaction/summarization where the message lives
# under "message"."content" (verified against real server transcripts
# 2026-08-07). Slash-command entries are stored as
# "<command-name>/x</command-name>..." — the title becomes the command
# (with args when present). System-injected entries (isMeta) are skipped.
first_user_title() {
  python3 -c '
import json, re, sys
p = sys.argv[1]
with open(p, encoding="utf-8", errors="replace") as fh:
    for line in fh:
        try:
            e = json.loads(line)
        except Exception:
            continue
        if e.get("type") != "user" or e.get("isMeta"):
            continue
        c = e.get("content")
        if c is None:
            m = e.get("message")
            c = m.get("content") if isinstance(m, dict) else None
        t = ""
        if isinstance(c, str):
            t = c
        elif isinstance(c, list):
            for b in c:
                if isinstance(b, dict) and isinstance(b.get("text"), str):
                    t = b["text"]
                    break
        if not t:
            continue
        name = re.search(r"<command-name>(.*?)</command-name>", t)
        if name:
            args = re.search(r"<command-args>(.*?)</command-args>", t)
            a = args.group(1).strip() if args and args.group(1).strip() else ""
            t = name.group(1).strip() + (" " + a if a else "")
        t = "".join(ch if ord(ch) >= 0x20 else " " for ch in t)
        t = t.replace("\t", " ").strip()
        print(t[:40])
        sys.exit(0)
' "$1" 2>/dev/null
}

# Newest session id in a project dir, or "-".
newest_session_id() {
  local enc="$1" dir="$PROJECTS_DIR/$enc"
  [ -d "$dir" ] || { echo "-"; return; }
  local newest
  newest="$(ls -t "$dir"/*.jsonl 2>/dev/null | head -1)"
  [ -n "$newest" ] || { echo "-"; return; }
  basename "$newest" .jsonl
}

# Descendants of $1 up to 6 levels deep, one pid per line.
descendants() {
  local root="$1" level=0
  local -a frontier=("$root") next=()
  while [ ${#frontier[@]} -gt 0 ] && [ "$level" -lt 6 ]; do
    next=()
    local pid child
    for pid in "${frontier[@]}"; do
      echo "$pid"
      for child in $(pgrep -P "$pid" 2>/dev/null); do
        next+=("$child")
      done
    done
    # Guard the empty-array expansion: bash <= 4.3 errors on "${next[@]}"
    # under set -u when the array has no elements.
    if [ "${#next[@]}" -gt 0 ]; then
      frontier=("${next[@]}")
    else
      frontier=()
    fi
    level=$((level + 1))
  done
}

# First descendant of the pane whose cmdline mentions claude, or "".
first_claude_descendant() {
  local pane_pid="$1" pid
  for pid in $(descendants "$pane_pid"); do
    if ps -p "$pid" -o args= 2>/dev/null | grep -q '[c]laude'; then
      echo "$pid"
      return
    fi
  done
}

# Real cwd of a process: /proc on Linux (the deployment host); lsof fallback
# so macOS dev/test machines can exercise the same paths.
pid_cwd() {
  local pid="$1" c
  c="$(readlink -f "/proc/$pid/cwd" 2>/dev/null)"
  [ -n "$c" ] || c="$(lsof -a -p "$pid" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p')"
  printf '%s' "$c"
}

# Transcript file currently open by a claude process: /proc fd-scan on the
# deployment host (Linux), lsof fallback for macOS test hosts. Prints the
# conversation id (basename without .jsonl) or nothing.
open_transcript_id() {
  local pid="$1" t
  if [ -d "/proc/$pid/fd" ]; then
    t="$(for f in /proc/$pid/fd/*; do readlink "$f" 2>/dev/null; done | grep -m1 '\.jsonl$')"
  else
    t="$(lsof -a -p "$pid" -Fn 2>/dev/null | sed -n 's/^n//p' | grep -m1 '\.jsonl$')"
  fi
  [ -n "$t" ] || return 0
  basename "$t" .jsonl
}

# index<TAB>name of all windows. tmux window names are NOT unique (a
# duplicate name makes every name-based target fail with "can't find
# window" — bug 2026-08-13), so ALL window targeting is by INDEX.
list_windows() {
  local session="$1"
  # $'...' expands \t BEFORE tmux sees it — tmux 3.3a does NOT interpret
  # backslash escapes inside -F format strings, and a literal "\t" would
  # break the index/name field split (bug 2026-08-13).
  tmux list-windows -t "$session" -F $'#{window_index}\t#{window_name}' 2>/dev/null
}

# First index whose name matches ("" when none).
window_index() {
  local session="$1" win="$2"
  list_windows "$session" | awk -F '\t' -v w="$win" '$2==w {print $1; exit}'
}

# Index of the session's active (selected) window.
active_window_index() {
  local session="$1"
  tmux display-message -p -t "$session" '#{active_window_index}' 2>/dev/null
}

# The conversation id a window's claude currently runs; $2 = window INDEX.
# Primary: an open transcript fd on the claude process (or any claude
# descendant — the launcher wrapper may not exec), which is CURRENT across
# in-session /resume. Fallback: the launch cmdline (--resume <id> /
# --session-id <id>), which is STALE after an in-session /resume. "" when
# unidentified.
window_conversation_id() {
  local session="$1" idx="$2" pane_pid id pid
  pane_pid="$(tmux list-panes -t "$session:$idx" -F '#{pane_pid}' 2>/dev/null | head -1)"
  [ -n "$pane_pid" ] || return 0
  for pid in $(descendants "$pane_pid"); do
    ps -p "$pid" -o args= 2>/dev/null | grep -q '[c]laude' || continue
    id="$(open_transcript_id "$pid")"
    [ -n "$id" ] && { echo "$id"; return 0; }
  done
  local claude args
  claude="$(first_claude_descendant "$pane_pid")"
  [ -n "$claude" ] || return 0
  args="$(ps -p "$claude" -o args= 2>/dev/null)"
  id="$(printf '%s' "$args" | grep -oE -- '--(resume|session-id) [A-Za-z0-9_-]+' | head -1 | awk '{print $2}')"
  [ -n "$id" ] && echo "$id"
  return 0
}

# Exit 0 when the window has a live claude descendant; $2 = window INDEX.
window_has_claude() {
  local session="$1" idx="$2" pane_pid
  pane_pid="$(tmux list-panes -t "$session:$idx" -F '#{pane_pid}' 2>/dev/null | head -1)"
  [ -n "$pane_pid" ] || return 1
  [ -n "$(first_claude_descendant "$pane_pid")" ]
}

# Exit 0 when the session has at least one attached client.
session_attached() {
  local session="$1"
  [ -n "$(tmux list-clients -t "$session" 2>/dev/null)" ]
}

# Index of the first window whose claude currently runs conversation $2;
# "" when none. Iterates INDEXES so duplicate window names cannot hide a
# window.
find_window_for() {
  local session="$1" id="$2" idx name
  while IFS=$'\t' read -r idx name; do
    [ "$(window_conversation_id "$session" "$idx")" = "$id" ] && { echo "$idx"; return 0; }
  done < <(list_windows "$session")
  return 0
}

# Cumulative CPU (utime+stime) of a process in HUNDREDTHS of a second;
# 0 when gone. Linux `ps -o utime=` prints integer jiffies (1/100 s);
# macOS prints MM:SS.cc — parse that form to centiseconds. The sweep
# threshold works in the same unit on both platforms.
cpu_ticks() {
  local pid="$1" u s
  u="$(ps -o utime= -p "$pid" 2>/dev/null | tr -d ' ')"
  s="$(ps -o stime= -p "$pid" 2>/dev/null | tr -d ' ')"
  local parse=""
  parse() {   # MM:SS.cc -> centiseconds; plain integer passes through
    local v="$1" mm ss cc
    case "$v" in
      *:*) mm="${v%%:*}"; v="${v#*:}"; ss="${v%%.*}"; cc="${v#*.}"; cc="${cc:-0}"
           echo $(( mm * 6000 + ss * 100 + ${cc:0:2} )) ;;
      ""|-|" "*) echo 0 ;;   # dead/gone process: ps prints "-" (Linux)
      *)    echo $(( ${v:-0} )) ;;
    esac
  }
  echo $(( $(parse "$u") + $(parse "$s") ))
}

list_base() {
  local base="$1" bname enc
  bname="$(cd "$base" 2>/dev/null && pwd -P)" || return 0
  enc="$(encode "$bname")"
  printf 'F\t%s\t%s\n' "$bname" "$enc"
  local d
  for d in "$bname"/*/; do
    [ -d "$d" ] || continue
    local dn="${d%/}"
    case "$(basename "$dn")" in
      .*) continue ;;
    esac
    printf 'F\t%s\t%s\n' "$dn" "$(encode "$dn")"
  done
}

list_sessions() {
  local enc="$1" dir="$PROJECTS_DIR/$enc"
  [ -d "$dir" ] || return 0
  local f
  for f in "$dir"/*.jsonl; do
    [ -f "$f" ] || continue
    local id mtime title
    id="$(basename "$f" .jsonl)"
    mtime="$(stat -c %Y "$f" 2>/dev/null || echo 0)"
    title="$(first_user_title "$f")"
    printf 'S\t%s\t%s\t%s\t%s\n' "$enc" "$id" "$mtime" "$title"
  done | sort -t $'\t' -k4 -rn | head -30
}

cmd_list() {
  local base="$1"
  list_base "$base" | while IFS=$'\t' read -r kind path enc; do
    if [ "$kind" = "F" ]; then
      printf 'F\t%s\t%s\n' "$path" "$enc"
      list_sessions "$enc"
    fi
  done
}

cmd_status() {
  local session="$1" idx pane_pid claude_pid cwd id win_name
  tmux has-session -t "$session" 2>/dev/null || { echo "none"; return 0; }
  idx="$(active_window_index "$session")"
  [ -n "$idx" ] || { echo "none"; return 0; }
  pane_pid="$(tmux list-panes -t "$session:$idx" -F '#{pane_pid}' 2>/dev/null | head -1)"
  [ -n "$pane_pid" ] || { echo "none"; return 0; }
  claude_pid="$(first_claude_descendant "$pane_pid")"
  [ -n "$claude_pid" ] || { echo "none"; return 0; }
  cwd="$(pid_cwd "$claude_pid")"
  [ -n "$cwd" ] || { echo "none"; return 0; }
  id="$(window_conversation_id "$session" "$idx")"
  win_name="$(tmux display-message -p -t "$session:$idx" '#{window_name}' 2>/dev/null)"
  # Self-healing (design §3.4): keep the window name in sync with the
  # conversation it actually runs (in-session /resume leaves a stale name).
  if [ -n "$id" ] && [ "$win_name" != "rokid-$id" ]; then
    tmux rename-window -t "$session:$idx" "rokid-$id" 2>/dev/null
  fi
  printf 'pid\t%s\t%s\t%s\n' "$claude_pid" "$cwd" "${id:--}"
}

cmd_switch() {
  local session="$1" base="$2" dir="$3" target="$4"
  local base_resolved dir_resolved
  base_resolved="$(cd "$base" 2>/dev/null && pwd -P)" || { printf 'error\t%s\n' "base not accessible"; return 1; }
  dir_resolved="$(cd "$dir" 2>/dev/null && pwd -P)" || { printf 'error\t%s\n' "path not accessible"; return 1; }
  # Validate the RESOLVED dir (handles .. and symlinks): base itself or a
  # path under it. ${var#prefix} literal-removal avoids case-pattern glob
  # metacharacters in the base path.
  if [ "$dir_resolved" = "$base_resolved" ] ||
     [ "${dir_resolved#"$base_resolved"/}" != "$dir_resolved" ]; then
    : # ok
  else
    printf 'error\t%s\n' "path outside base"; return 1
  fi

  local id launch_args
  case "$target" in
    resume:*)
      id="${target#resume:}"
      case "$id" in
        *[!A-Za-z0-9_-]*) printf 'error\t%s\n' "bad session id"; return 1 ;;
      esac
      launch_args="--resume $id"
      ;;
    new:*)
      id="${target#new:}"
      case "$id" in
        *[!A-Za-z0-9-]*) printf 'error\t%s\n' "bad session id"; return 1 ;;
      esac
      launch_args="--session-id $id"
      ;;
    *)
      printf 'error\t%s\n' "bad target"; return 1 ;;
  esac

  local launch_cmd="$CLAUDE_LAUNCHER --effort max --dangerously-skip-permissions $launch_args"

  # Attach semantics (design 2026-08-11 §3.3): a conversation's window is
  # SELECTED, never restarted, when its claude is alive; dead windows are
  # respawned in place; missing windows are created. Only the session-level
  # first launch (no session at all) creates the session. All window
  # targeting is by INDEX — tmux window names are not unique, and a
  # duplicate name makes name-based targets fail with "can't find window"
  # (bug 2026-08-13).
  local win_idx
  if ! tmux has-session -t "$session" 2>/dev/null; then
    tmux new-session -d -s "$session" -n "rokid-$id" -c "$dir_resolved" "$launch_cmd" \
      || { printf 'error\t%s\n' "tmux create failed"; return 1; }
    # A dead claude must leave a dead pane in a surviving window (the
    # confirmed contract: re-select respawns it), not kill the whole
    # session and drop the app's attach (design 2026-08-11 §4).
    tmux set-option -t "$session" remain-on-exit on 2>/dev/null
  else
    win_idx="$(find_window_for "$session" "$id")"
    if [ -n "$win_idx" ]; then
      # Found by identification: sync the name (in-session /resume or a
      # legacy window left a stale name) and select.
      local found_name
      found_name="$(tmux display-message -p -t "$session:$win_idx" '#{window_name}' 2>/dev/null)"
      [ "$found_name" = "rokid-$id" ] || tmux rename-window -t "$session:$win_idx" "rokid-$id" 2>/dev/null
      tmux select-window -t "$session:$win_idx"
    else
      win_idx="$(window_index "$session" "rokid-$id")"
      if [ -n "$win_idx" ]; then
        # Named window exists: respawn ONLY when its claude is dead. An
        # ALIVE claude is selected as-is (attach semantics — bug 2026-08-13:
        # the old code killed it unconditionally, restarting a running
        # conversation on every re-select).
        local pane_pid claude_pid
        pane_pid="$(tmux list-panes -t "$session:$win_idx" -F '#{pane_pid}' 2>/dev/null | head -1)"
        [ -n "$pane_pid" ] || { printf 'error\t%s\n' "no tmux pane"; return 1; }
        claude_pid="$(first_claude_descendant "$pane_pid")"
        if [ -z "$claude_pid" ]; then
          if ! tmux respawn-pane -t "$session:$win_idx" -k -c "$dir_resolved" "$launch_cmd" 2>/dev/null; then
            local qdir
            qdir="$(printf '%q' "$dir_resolved")"
            tmux send-keys -t "$session:$win_idx" "cd $qdir && $launch_cmd" Enter
          fi
        fi
        tmux select-window -t "$session:$win_idx"
      else
        tmux new-window -n "rokid-$id" -c "$dir_resolved" "$launch_cmd" \
          || { printf 'error\t%s\n' "tmux create failed"; return 1; }
        # new-window without -d selects the new window (no name target).
      fi
    fi
  fi

  # Verify: a Claude process whose cwd is the target dir (poll <= 15 s).
  # Targets the ACTIVE window (the one just selected) by INDEX.
  local i ok=""
  for i in $(seq 1 30); do
    local active_idx pane_pid2 claude_pid2 cwd2
    active_idx="$(active_window_index "$session")"
    [ -n "$active_idx" ] || break
    pane_pid2="$(tmux list-panes -t "$session:$active_idx" -F '#{pane_pid}' 2>/dev/null | head -1)"
    [ -n "$pane_pid2" ] || break
    claude_pid2="$(first_claude_descendant "$pane_pid2")"
    if [ -n "$claude_pid2" ]; then
      cwd2="$(pid_cwd "$claude_pid2")"
      if [ "$cwd2" = "$dir_resolved" ]; then
        ok="$claude_pid2"
        break
      fi
    fi
    sleep 0.5
  done
  [ -n "$ok" ] || { printf 'error\t%s\n' "claude did not start"; return 1; }

  # resume: the session file must exist (a fresh session's JSONL appears on
  # the first message, so for new: pid+cwd above is enough).
  case "$target" in
    resume:*)
      local enc expected
      enc="$(encode "$dir_resolved")"
      expected="$PROJECTS_DIR/$enc/$id.jsonl"
      for i in $(seq 1 10); do
        [ -f "$expected" ] && break
        sleep 0.5
      done
      [ -f "$expected" ] || { printf 'error\t%s\n' "session file missing"; return 1; }
      ;;
  esac

  printf 'ok\t%s\t%s\n' "$(encode "$dir_resolved")" "$id"
}

cmd_delete() {
  local session="$1" base="$2" dir="$3" id="$4"
  case "$id" in
    *[!A-Za-z0-9_-]*) printf 'error\t%s\n' "bad session id"; return 1 ;;
  esac
  local base_resolved dir_resolved
  base_resolved="$(cd "$base" 2>/dev/null && pwd -P)" || { printf 'error\t%s\n' "base not accessible"; return 1; }
  dir_resolved="$(cd "$dir" 2>/dev/null && pwd -P)" || { printf 'error\t%s\n' "path not accessible"; return 1; }
  if [ "$dir_resolved" = "$base_resolved" ] ||
     [ "${dir_resolved#"$base_resolved"/}" != "$dir_resolved" ]; then
    : # ok
  else
    printf 'error\t%s\n' "path outside base"; return 1
  fi
  local enc target win_idx
  enc="$(encode "$dir_resolved")"
  target="$PROJECTS_DIR/$enc/$id.jsonl"
  # The conversation's window (design 2026-08-11 §3.3): found by
  # identification first (it may live under a stale name), else by name when
  # its claude is dead. A window named rokid-<id> that is ALIVE with a
  # different conversation is stale — it belongs to that other conversation
  # and is never killed here (it self-heals when THAT conversation is
  # deleted or switched). All targeting by INDEX (duplicate names break
  # name-based targets — bug 2026-08-13).
  win_idx="$(find_window_for "$session" "$id")"
  if [ -z "$win_idx" ]; then
    local named_idx
    named_idx="$(window_index "$session" "rokid-$id")"
    if [ -n "$named_idx" ]; then
      local pane_pid claude_pid
      pane_pid="$(tmux list-panes -t "$session:$named_idx" -F '#{pane_pid}' 2>/dev/null | head -1)"
      claude_pid="$(first_claude_descendant "$pane_pid")"
      [ -z "$claude_pid" ] && win_idx="$named_idx"   # dead window is the conversation's
    fi
  fi
  local killed=""
  if [ -n "$win_idx" ]; then
    # Refuse the ATTACHED conversation (defense in depth; the app also
    # blocks the ▶ row). Only when the window is the session's active
    # window AND a client is attached.
    if [ "$win_idx" = "$(active_window_index "$session")" ] && session_attached "$session"; then
      printf 'error\t%s\n' "active session"
      return 1
    fi
    tmux kill-window -t "$session:$win_idx" 2>/dev/null
    killed="1"
  fi
  # A never-messaged new chat has NO jsonl — its window IS the conversation;
  # killing it is the whole delete (bug 2026-08-12: the old order killed the
  # window then errored "not found", leaving the app's picker row + local
  # files orphaned). "not found" now only fires for phantom conversations
  # (no window AND no transcript).
  if [ -f "$target" ]; then
    rm -f "$target" || { printf 'error\t%s\n' "delete failed"; return 1; }
  elif [ -z "$killed" ]; then
    printf 'error\t%s\n' "not found"
    return 1
  fi
  printf 'ok\t%s\t%s\n' "$enc" "$id"
}

# Rename the ACTIVE window to rokid-<new-id> (design 2026-08-11 §3.4: the
# app's new-chat discover convergence, when the server ignored --session-id
# and generated its own real id). Guarded: only when the active window's
# claude is alive in the given dir — a wrong target must never be renamed.
cmd_adopt() {
  local session="$1" dir="$2" new_id="$3"
  case "$new_id" in
    *[!A-Za-z0-9_-]*) printf 'error\t%s\n' "bad session id"; return 1 ;;
  esac
  local idx win_name pane_pid claude_pid cwd
  idx="$(active_window_index "$session")"
  [ -n "$idx" ] || { printf 'error\t%s\n' "no active window"; return 1; }
  pane_pid="$(tmux list-panes -t "$session:$idx" -F '#{pane_pid}' 2>/dev/null | head -1)"
  [ -n "$pane_pid" ] || { printf 'error\t%s\n' "no tmux pane"; return 1; }
  claude_pid="$(first_claude_descendant "$pane_pid")"
  [ -n "$claude_pid" ] || { printf 'error\t%s\n' "no claude"; return 1; }
  cwd="$(pid_cwd "$claude_pid")"
  [ "$cwd" = "$dir" ] || { printf 'error\t%s\n' "cwd mismatch"; return 1; }
  win_name="$(tmux display-message -p -t "$session:$idx" '#{window_name}' 2>/dev/null)"
  if [ "$win_name" != "rokid-$new_id" ]; then
    tmux rename-window -t "$session:$idx" "rokid-$new_id" 2>/dev/null \
      || { printf 'error\t%s\n' "rename failed"; return 1; }
  fi
  printf 'ok\t%s\t%s\n' "$(encode "$dir")" "$new_id"
}

# Cheap idle pre-filter (design 2026-08-11 §3.6): a window is an idle
# candidate when its claude is dead, or (JSONL old AND no descendant
# children). Unknowns are treated as BUSY (never kill what we cannot prove
# idle). $2 = window INDEX. Exit 0 = idle candidate.
idle_fast() {
  local session="$1" idx="$2" idle_secs="$3" pane_pid claude_pid cwd id jsonl
  pane_pid="$(tmux list-panes -t "$session:$idx" -F '#{pane_pid}' 2>/dev/null | head -1)"
  [ -n "$pane_pid" ] || return 0
  claude_pid="$(first_claude_descendant "$pane_pid")"
  [ -n "$claude_pid" ] || return 0
  local pid
  for pid in $(descendants "$claude_pid"); do
    [ "$pid" = "$claude_pid" ] && continue
    return 1   # child present -> busy, not even a candidate
  done
  cwd="$(pid_cwd "$claude_pid")"
  id="$(window_conversation_id "$session" "$idx")"
  if [ -n "$cwd" ] && [ -n "$id" ]; then
    jsonl="$PROJECTS_DIR/$(encode "$cwd")/$id.jsonl"
    if [ -f "$jsonl" ]; then
      local mtime age
      mtime="$(stat -c %Y "$jsonl" 2>/dev/null || stat -f %m "$jsonl" 2>/dev/null)"
      age=$(( $(date +%s) - mtime ))
      [ "$age" -lt "$idle_secs" ] && return 1   # recently active
    fi
  fi
  return 0
}

# End idle background conversations (design 2026-08-11 §3.6). Two phases so
# the CPU sample sleeps ONCE for all candidates. The ACTIVE window is never
# swept (the user is attached to it). Never touches JSONL — a swept
# conversation stays in the picker and re-select respawns it via switch.
# Also self-heals duplicate window names (bug 2026-08-13: tmux allows
# duplicate names, which blind name-based targeting): the later duplicate
# is renamed to its identified conversation id. Output: `swept\t<count>`.
cmd_sweep() {
  local session="$1" base="$2" idle_min="${3:-180}"
  local idle_secs=$(( idle_min * 60 ))
  tmux has-session -t "$session" 2>/dev/null || { echo "swept	0"; return 0; }
  local active_idx idx name count=0 seen=""
  active_idx="$(active_window_index "$session")"
  local -a candidates=()
  while IFS=$'\t' read -r idx name; do
    # Duplicate-name self-heal: a repeated window name gets renamed to the
    # conversation its claude actually runs (if identifiable).
    if [ -n "$seen" ] && case " $seen " in *" $name "*) true;; *) false;; esac; then
      local dup_id
      dup_id="$(window_conversation_id "$session" "$idx")"
      if [ -n "$dup_id" ] && [ "$name" != "rokid-$dup_id" ]; then
        tmux rename-window -t "$session:$idx" "rokid-$dup_id" 2>/dev/null
      fi
    fi
    seen="$seen $name"
    [ "$idx" = "$active_idx" ] && continue
    if idle_fast "$session" "$idx" "$idle_secs"; then
      candidates+=("$idx")
    fi
  done < <(list_windows "$session")
  if [ ${#candidates[@]} -gt 0 ]; then
    sleep "${SWEEP_SAMPLE_SLEEP:-120}"
    local w t1 t2 s1 s2 wall cpus pane_pid claude_pid
    for w in "${candidates[@]}"; do
      pane_pid="$(tmux list-panes -t "$session:$w" -F '#{pane_pid}' 2>/dev/null | head -1)"
      claude_pid="$(first_claude_descendant "$pane_pid")"
      [ -n "$claude_pid" ] || { count=$((count+1)); tmux kill-window -t "$session:$w" 2>/dev/null; continue; }
      t1="$(date +%s)"; s1="$(cpu_ticks "$claude_pid")"
      sleep 2
      t2="$(date +%s)"; s2="$(cpu_ticks "$claude_pid")"
      wall=$(( t2 - t1 )); [ "$wall" -lt 1 ] && wall=1
      # cpus is in hundredths of a second (both platforms, see cpu_ticks).
      # Busy when CPU-seconds >= 0.5% of wall time: cpus >= wall*0.5.
      cpus=$(( s2 - s1 ))
      if [ $(( cpus * 2 )) -lt "$wall" ]; then
        tmux kill-window -t "$session:$w" 2>/dev/null && count=$((count+1))
      fi
    done
  fi
  printf 'swept\t%d\n' "$count"
}

# Export a conversation as plain text rows for the app's local scrollback:
# user messages get a "❯ " prefix, assistant text is plain, tool results are
# skipped, control chars stripped, each line truncated, newest EXPORT_MAX
# lines only. Validation identical to cmd_delete (resolved dir under base,
# id charset). Output: plain lines (no F/S protocol).
cmd_export() {
  local base="$1" dir="$2" id="$3"
  case "$id" in
    *[!A-Za-z0-9_-]*) printf 'error\t%s\n' "bad session id"; return 1 ;;
  esac
  local base_resolved dir_resolved
  base_resolved="$(cd "$base" 2>/dev/null && pwd -P)" || { printf 'error\t%s\n' "base not accessible"; return 1; }
  dir_resolved="$(cd "$dir" 2>/dev/null && pwd -P)" || { printf 'error\t%s\n' "path not accessible"; return 1; }
  if [ "$dir_resolved" = "$base_resolved" ] ||
     [ "${dir_resolved#"$base_resolved"/}" != "$dir_resolved" ]; then
    : # ok
  else
    printf 'error\t%s\n' "path outside base"; return 1
  fi
  local enc target
  enc="$(encode "$dir_resolved")"
  target="$PROJECTS_DIR/$enc/$id.jsonl"
  [ -f "$target" ] || { printf 'error\t%s\n' "not found"; return 1; }
  python3 - "$target" << 'PYEOF'
import json, re, sys
path = sys.argv[1]
MAX = 2000
out = []

def emit_block(lines, prefix):
    # Trim the block's leading/trailing blank lines, then emit it separated
    # from the previous block by one blank row (layout: input and output
    # blocks are visually distinct — user 2026-08-07).
    while lines and not lines[0].strip():
        lines.pop(0)
    while lines and not lines[-1].strip():
        lines.pop()
    if not lines:
        return
    if out:
        out.append("")
    for ln in lines:
        # Strip ANSI CSI sequences (slash-command outputs carry bold codes).
        ln = re.sub(r"\x1b\[[0-9;]*[A-Za-z]", "", ln)
        # 2000-char cap (was 100 — long user prompts were truncated before
        # the app could wrap them; the client wraps at its 54-column grid,
        # user report 2026-08-14: restored history looked unwrapped and
        # prompts vanished).
        clean = "".join(ch if ord(ch) >= 0x20 else " " for ch in ln)
        out.append((prefix + clean[:2000]) if clean.strip() else "")

with open(path, encoding="utf-8", errors="replace") as fh:
    for line in fh:
        try:
            e = json.loads(line)
        except Exception:
            continue
        t = e.get("type")
        if t == "user":
            if e.get("isMeta"):
                continue
            c = e.get("content")
            if c is None:
                m = e.get("message")
                c = m.get("content") if isinstance(m, dict) else None
            text = ""
            if isinstance(c, str):
                text = c
            elif isinstance(c, list):
                for b in c:
                    if isinstance(b, dict) and isinstance(b.get("text"), str):
                        text = b["text"]
                        break
            if not text:
                continue
            # Slash commands are stored as XML blocks — collapse to the
            # command name (same logic as the title extraction).
            name = re.search(r"<command-name>(.*?)</command-name>", text)
            if name:
                args = re.search(r"<command-args>(.*?)</command-args>", text)
                a = args.group(1).strip() if args and args.group(1).strip() else ""
                text = name.group(1).strip() + (" " + a if a else "")
            # <local-command-stdout> entries are the COMMAND'S OUTPUT, not a
            # user input — render them as plain output (no ❯ prefix, no
            # dark fill; user report 2026-08-07). The wrapper tags are
            # stripped for reading.
            is_command_output = "<local-command-stdout>" in text
            text = re.sub(r"</?local-command-stdout>", "", text)
            emit_block(text.splitlines(), "" if is_command_output else "❯ ")
        elif t == "assistant":
            # Rewritten (compacted) transcripts put assistant content under
            # "message"."content" too — without this the assistant replies
            # were dropped and history showed only user inputs (bug 2,
            # 2026-08-07).
            c = e.get("content")
            if c is None:
                m = e.get("message")
                c = m.get("content") if isinstance(m, dict) else None
            if isinstance(c, str):
                blocks = [{"text": c}]
            elif isinstance(c, list):
                blocks = c
            else:
                continue
            for b in blocks:
                if isinstance(b, dict) and isinstance(b.get("text"), str):
                    emit_block(b["text"].splitlines(), "")
        if len(out) > MAX * 2:
            del out[: len(out) - MAX * 2]
print("\n".join(out[-MAX:]))
PYEOF
}

main() {
  local verb="${1:-}"
  case "$verb" in
    adopt)
      [ $# -ge 4 ] || { printf 'error\t%s\n' "usage: adopt <tmux-session> <real-dir> <new-id>"; return 1; }
      cmd_adopt "$2" "$3" "$4"
      ;;
    delete)
      [ $# -ge 5 ] || { printf 'error\t%s\n' "usage: delete <tmux-session> <base-dir> <real-dir> <session-id>"; return 1; }
      cmd_delete "$2" "$3" "$4" "$5"
      ;;
    export)
      [ $# -ge 4 ] || { printf 'error\t%s\n' "usage: export <base-dir> <real-dir> <session-id>"; return 1; }
      cmd_export "$2" "$3" "$4"
      ;;
    list)
      [ $# -ge 2 ] || { printf 'error\t%s\n' "usage: list <base-dir>"; return 1; }
      cmd_list "$2"
      ;;
    status)
      [ $# -ge 2 ] || { printf 'error\t%s\n' "usage: status <tmux-session>"; return 1; }
      cmd_status "$2"
      ;;
    sweep)
      [ $# -ge 3 ] || { printf 'error\t%s\n' "usage: sweep <tmux-session> <base-dir> [idle-minutes]"; return 1; }
      cmd_sweep "$2" "$3" "${4:-180}"
      ;;
    switch)
      [ $# -ge 5 ] || { printf 'error\t%s\n' "usage: switch <tmux-session> <base-dir> <real-dir> <resume:id|new:uuid>"; return 1; }
      cmd_switch "$2" "$3" "$4" "$5"
      ;;
    *)
      printf 'error\t%s\n' "unknown verb"
      return 1
      ;;
  esac
}

# Testability hook (design 2026-08-11): sourcing with ROKID_SESSIONS_SOURCE=1
# defines the functions without running main() — the harness
# (server/test/helper_test.sh) exercises internals directly.
[ "${ROKID_SESSIONS_SOURCE:-0}" = "1" ] || main "$@"
