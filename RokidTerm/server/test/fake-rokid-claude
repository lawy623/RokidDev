#!/usr/bin/env bash
# Fake /home/rokid/bin/rokid-claude for helper harness tests. The pane runs
# this script, so its cmdline contains "claude" (findable by
# first_claude_descendant). Env controls (note: tmux panes do NOT inherit
# the invoking shell's env — vars must be passed as command-string prefixes,
# e.g. `ROKID_FAKE_CPU=4 $FAKE ...`):
#   ROKID_FAKE_JSONL=<path>  hold an fd open to this transcript file
#   ROKID_FAKE_CHILD=1       spawn a sleeping child (busy-descendant signal)
#   ROKID_FAKE_CPU=<secs>    burn that many CPU-seconds in a loop
# Log: appends to $TMPDIR/rokid-fake-launch.log (shared, truncated per
# scenario by the harness) — a fixed path because env vars cannot reach the
# pane through the tmux server environment.
id=""
while [ $# -gt 0 ]; do
  case "$1" in
    --resume) id="$2"; shift 2 ;;
    --session-id) id="$2"; shift 2 ;;
    *) shift ;;
  esac
done
echo "start id=${id:-}" >> "${TMPDIR:-/tmp}/rokid-fake-launch.log"
if [ -n "${ROKID_FAKE_JSONL:-}" ]; then exec 3>>"$ROKID_FAKE_JSONL"; fi
if [ "${ROKID_FAKE_CHILD:-0}" = "1" ]; then sleep 300 & fi
if [ "${ROKID_FAKE_CPU:-0}" -gt 0 ]; then
  end=$(( $(date +%s) + ROKID_FAKE_CPU ))
  while [ "$(date +%s)" -lt "$end" ]; do :; done
fi
# Idle IN-PROCESS (no child — the helper's busy signal is child presence):
# read blocks on the pane's pty stdin for 300 s and times out. A `sleep`
# child would make every live fake look busy.
read -t 300
